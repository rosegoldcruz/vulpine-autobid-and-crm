# --- Twilio App configuration ---------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit a real `.env` with credentials.

# Port the web UI listens on
PORT=8080

# Public HTTPS base URL where THIS app is reachable by Twilio's servers.
# Example: https://sms.yourdomain.com
# Used to build webhook URLs and to validate X-Twilio-Signature.
# Webhooks will not work until this is set correctly.
PUBLIC_BASE_URL=https://twilio.example.com

# Password for the single admin login on the web UI. Use a long random value.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Fernet key used to encrypt Twilio auth tokens at rest in SQLite.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty the app generates an ephemeral key on each boot (tokens won't
# survive restarts) and logs a warning.
ENCRYPTION_KEY=

# Optional: secret used to sign the admin session cookie.
# If empty, one is generated at boot (sessions reset on restart).
SECRET_KEY=

# Where the SQLite database file lives. In Docker this is /data (a volume).
DATA_DIR=./data
