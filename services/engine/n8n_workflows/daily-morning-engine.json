{
  "name": "Vulpine Daily Morning Engine",
  "nodes": [
    {
      "name": "Schedule (Weekday 7AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{"field": "cron", "expression": "0 7 * * 1-5"}]
        }
      }
    },
    {
      "name": "Score All Unscored Contacts",
      "type": "n8n-nodes-base.httpRequest",
      "position": [500, 300],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/scoring/batch",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "limit", "value": 500},
            {"name": "use_ai", "value": true}
          ]
        }
      }
    },
    {
      "name": "Send Outreach to BID_NOW",
      "type": "n8n-nodes-base.httpRequest",
      "position": [750, 200],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/outreach/batch",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "tier", "value": "BID_NOW"},
            {"name": "limit", "value": 50}
          ]
        }
      }
    },
    {
      "name": "Voice Campaign HIGH_PRIORITY",
      "type": "n8n-nodes-base.httpRequest",
      "position": [750, 400],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/api/v1/voice/campaign",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "tier", "value": "HIGH_PRIORITY"},
            {"name": "max_calls", "value": 10}
          ]
        }
      }
    },
    {
      "name": "Generate Daily Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1000, 300],
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/api/v1/pipeline/summary"
      }
    },
    {
      "name": "Send Briefing Email/Slack",
      "type": "n8n-nodes-base.noOp",
      "position": [1250, 300],
      "parameters": {}
    }
  ],
  "connections": {
    "Schedule (Weekday 7AM)": {
      "main": [["Score All Unscored Contacts"]]
    },
    "Score All Unscored Contacts": {
      "main": [["Send Outreach to BID_NOW", "Voice Campaign HIGH_PRIORITY"]]
    },
    "Send Outreach to BID_NOW": {
      "main": [["Generate Daily Briefing"]]
    },
    "Voice Campaign HIGH_PRIORITY": {
      "main": [["Generate Daily Briefing"]]
    },
    "Generate Daily Briefing": {
      "main": [["Send Briefing Email/Slack"]]
    }
  }
}
