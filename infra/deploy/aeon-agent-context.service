[Unit]
Description=Export selected AEON continuity for authenticated agent reads
After=vulpine-operations.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/node /opt/vulpine-platform/scripts/export-agent-context.mjs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vulpine-operations
UMask=0077
