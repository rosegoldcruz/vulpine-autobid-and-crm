# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLM_PROVIDER: gemini | openai-compatible
LLM_PROVIDER="gemini"

# LLM_MODEL: model id used by selected provider.
LLM_MODEL="gemini-2.5-flash"

# LLM_API_KEY: generic key used by selected provider.
# For gemini, GEMINI_API_KEY is also supported for backward compatibility.
LLM_API_KEY=""

# LLM_BASE_URL: required for openai-compatible provider.
# Example: https://api.openai.com/v1 or https://openrouter.ai/api/v1
LLM_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VISION_API_URL: Base URL for vulpine-vision service.
# Example: http://localhost:3000
VISION_API_URL="http://localhost:3000"

# VISION_INTEGRATION_KEY: Shared secret expected by Vision
# endpoint POST /api/integrations/leads/handoff.
VISION_INTEGRATION_KEY="replace-with-vision-integration-key"
